# ==============================================================================
# RANGA STORE (rangastore.shop) - PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# SAFE CONFIGURATION SPECIFICATION
# All credentials, connection strings, and keys below are safe placeholder templates.
# Replace values with your actual production secrets in your hosting dashboards.
# DO NOT commit real secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API & WEBSOCKET SERVER (Configure on Render / Linux VPS)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000

# MongoDB Atlas Cloud Database Connection String
# Example format: mongodb+srv://<db_username>:<db_password>@<cluster_host>/<db_name>?retryWrites=true&w=majority
# Note: Reserved characters in password must be URL-encoded (%23 for #, %40 for @)
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.csrjc8a.mongodb.net/flipkart?retryWrites=true&w=majority

# JWT Token Configuration
# Generate 64-character crypto secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_cryptographically_secure_64_character_random_hex_string
JWT_EXPIRE=7d
COOKIE_EXPIRE=5

# Production Domains & CORS Whitelist (Cross-subdomain support)
FRONTEND_URL=https://rangastore.shop
ADMIN_URL=https://admin.rangastore.shop
CLIENT_URL=https://rangastore.shop

# Master Store Administrator Credentials (Must be strong, non-default credentials)
ADMIN_EMAIL=admin@rangastore.shop
ADMIN_PASSWORD=SetAStrongRandomAdminPassword123!

# Store Receiver UPI ID & Merchant Identity (Dynamic UPI QR payments)
MERCHANT_UPI_ID=nexmartpay@icici
MERCHANT_PAYEE_NAME=Ranga Store

# Cloudinary Storage for Product & Banner Image Uploads (Optional)
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Transactional Email Notification Service (SendGrid or SMTP)
# Option A: SendGrid
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_MAIL=support@rangastore.shop
SENDGRID_RESET_TEMPLATEID=d-your_reset_template_id
SENDGRID_ORDER_TEMPLATEID=d-your_order_template_id

# Option B: SMTP (Gmail / Custom Mail Server)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SERVICE=gmail
SMTP_MAIL=support@rangastore.shop
SMTP_PASSWORD=your_smtp_app_password

# Optional Payment Gateway Fallbacks (Paytm / Stripe)
PAYTM_MID=your_paytm_merchant_id
PAYTM_MERCHANT_KEY=your_paytm_merchant_key
PAYTM_WEBSITE=DEFAULT
PAYTM_CHANNEL_ID=WEB
PAYTM_INDUSTRY_TYPE=Retail
PAYTM_CUST_ID=your_paytm_cust_id

STRIPE_API_KEY=pk_live_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key

# ------------------------------------------------------------------------------
# 2. CUSTOMER FRONTEND WEBSITE (Configure in Vercel Project 1: frontend)
# ------------------------------------------------------------------------------
REACT_APP_BACKEND_URL=https://api.rangastore.shop
REACT_APP_SOCKET_URL=https://api.rangastore.shop

# ------------------------------------------------------------------------------
# 3. DEDICATED ADMIN DASHBOARD (Configure in Vercel Project 2: admin)
# ------------------------------------------------------------------------------
PORT=3001
REACT_APP_BACKEND_URL=https://api.rangastore.shop
REACT_APP_SOCKET_URL=https://api.rangastore.shop

