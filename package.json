{
  "name": "flipkart",
  "version": "1.0.0",
  "description": "Full Stack Flipkart Ecommerce",
  "main": "server.js",
  "scripts": {
    "build": "npm install --prefix frontend --legacy-peer-deps && npm run build --prefix frontend",
    "start": "node server.js",
    "server": "node server.js",
    "frontend": "npm start --prefix frontend",
    "gateway": "npm run dev --prefix \"Payment gateway/YouPI-PG-main\"",
    "gateway:setup": "node \"Payment gateway/YouPI-PG-main/scripts/init-db.cjs\"",
    "dev": "concurrently \"npm run server\" \"npm run frontend\"",
    "dev:all": "concurrently \"npm run server\" \"npm run frontend\" \"npm run gateway\"",
    "set-admin": "node backend/utils/setAdminCredentials.js",
    "set-upi": "node scripts/set-merchant-upi.js",
    "render-postbuild": "NPM_CONFIG_PRODUCTION=false && npm install --prefix frontend && npm run build --prefix frontend"
  },
  "author": "Flipkart",
  "license": "ISC",
  "dependencies": {
    "@sendgrid/mail": "^7.6.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.19.1",
    "cloudinary": "^1.28.1",
    "concurrently": "^7.6.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^14.2.0",
    "express": "^4.17.2",
    "express-fileupload": "^1.2.1",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^6.1.7",
    "nodemailer": "^6.7.2",
    "paytmchecksum": "^1.5.0",
    "stripe": "^8.200.0",
    "uuid": "^8.3.2",
    "validator": "^13.7.0"
  }
}
