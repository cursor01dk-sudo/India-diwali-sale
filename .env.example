# ========================================================
# VERCEL ENVIRONMENT VARIABLES CONFIGURATION GUIDE
# Add these in Vercel Dashboard -> Project Settings -> Environment Variables
# ========================================================

# 1. DATABASE (Required on Vercel)
# Note: Local 127.0.0.1 won't work on Vercel cloud serverless.
# Create a free database on MongoDB Atlas (https://www.mongodb.com/cloud/atlas)
# and paste your connection string below:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/flipkart?retryWrites=true&w=majority

# 2. JWT & AUTHENTICATION (Required)
JWT_SECRET=WFFWf15115U842UGUBWF81EE858UYBY51BGBJ5E51Q_FLIPKART_LIVE
JWT_EXPIRE=7d
COOKIE_EXPIRE=5
NODE_ENV=production

# 3. UPI PAYMENT GATEWAY (Required for UPI payments on your domain)
MERCHANT_UPI_ID=deepakddoswala@fam
MERCHANT_PAYEE_NAME=Flipkart Payments

# 4. CLOUDINARY (Optional for photo uploads)
CLOUDINARY_NAME=store
CLOUDINARY_API_KEY=7467848571151
CLOUDINARY_API_SECRET=secret_key

