{
  "version": 2,
  "buildCommand": "npm install --prefix frontend --legacy-peer-deps && npm run build --prefix frontend",
  "outputDirectory": "frontend/build",
  "functions": {
    "api/**/*.js": {
      "includeFiles": "backend/data/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}